# =============================================================================
# ExamSync — .gitignore
# Based on github/gitignore Node.js template + project-specific additions
# =============================================================================

# ── Logs ─────────────────────────────────────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ── Runtime data ──────────────────────────────────────────────────────────────
pids
*.pid
*.seed
*.pid.lock

# ── Coverage ──────────────────────────────────────────────────────────────────
coverage
*.lcov
.nyc_output

# ── Build output ──────────────────────────────────────────────────────────────
build/Release
dist
.next
out
.nuxt
.output
.svelte-kit/
**/.vitepress/dist
**/.vitepress/cache
.docusaurus
.serverless/
.fusebox/
.dynamodb/
.firebase/

# ── Dependency directories ────────────────────────────────────────────────────
node_modules/
jspm_packages/
bower_components
web_modules/

# ── Environment variables — NEVER commit these ────────────────────────────────
.env
.env.*
!.env.example

# ── Caches ────────────────────────────────────────────────────────────────────
.cache
.parcel-cache
.grunt
.eslintcache
.stylelintcache
.npm
.pnpm-store
lib-cov
.lock-wscript

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo

# ── Package manager artifacts ─────────────────────────────────────────────────
*.tgz
.yarn-integrity
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ── Vite ──────────────────────────────────────────────────────────────────────
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# ── Misc Node ─────────────────────────────────────────────────────────────────
.node_repl_history
.tern-port
.vscode-test

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── Editor ────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
